IMMICH_URL=<http://instance-url>:<port>
IMMICH_API_KEY=<your-api-key>
APP_PORT=8765
# Browser-facing Immich URL used for post-upload links, preferably your FQDN.
IMMICH_PUBLIC_URL=https://photos.example.com
# Optional LAN URL used when the uploader is accessed through a private IP.
IMMICH_LAN_URL=http://192.168.1.101:2283
X_COOKIES_FILE=/run/secrets/x-cookies.txt
X_COOKIES_PATH=./cookies.txt

